{
	"name": "@iwsio/iwsio-packages",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"main": "",
	"scripts": {
		"dev": "pnpm -r --parallel watch",
		"clean": "del-cli '**/dist' '**/coverage' '**/*.tsbuildinfo'",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:fix:unsafe": "biome check --write --unsafe .",
		"test": "vitest --run"
	},
	"packageManager": "pnpm@12.16.1",
	"author": "Nathan Bridgewater",
	"license": "ISC",
	"workspaces": [
		"packages/*",
		"!packages/eslint-config"
	],
	"dependencies": {
		"@biomejs/biome": "^2.6.4",
		"@iwsio/biome-config": "workspace:*",
		"@iwsio/tsconfig": "workspace:*"
	},
	"devDependencies": {
		"del-cli": "^8.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
